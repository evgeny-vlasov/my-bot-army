# ============================================================================
# My Bot Army - Environment Configuration
# Flask-based Production System
# ============================================================================

# ----------------------------------------------------------------------------
# Anthropic API Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ----------------------------------------------------------------------------
# Voyage AI API Configuration (REQUIRED for RAG)
# ----------------------------------------------------------------------------
# Get your API key from: https://www.voyageai.com/
# Models: voyage-3-lite (512d, $0.06/1M), voyage-3 (1024d, $0.12/1M)
# Production uses: voyage-3-lite
VOYAGE_API_KEY=pa-your-voyage-api-key-here

# ----------------------------------------------------------------------------
# Database Configuration (Flask - Synchronous)
# ----------------------------------------------------------------------------
# Database name: botfarm
# User: botfarm
# Host: localhost
# Port: 5432 (default)
DB_PASSWORD=your_secure_password_here

# Note: Flask uses psycopg2 (synchronous), NOT asyncpg
# Connection managed in shared/database.py using psycopg2.connect()
# Optional connection string format (not used in current implementation):
# DATABASE_URL=postgresql://botfarm:password@localhost/botfarm

# ----------------------------------------------------------------------------
# RAG Configuration (Optional - defaults in bot configs)
# ----------------------------------------------------------------------------
RAG_ENABLED=true                    # Master switch for RAG functionality
RAG_TOP_K=5                         # Number of chunks to retrieve
RAG_SIMILARITY_THRESHOLD=0.7        # Minimum similarity score (0-1)
KEYSTONE_RAG_ENABLED=true           # Keystone bot RAG switch

# ----------------------------------------------------------------------------
# Bot Configuration (Flask Application)
# ----------------------------------------------------------------------------
BOT_ID=keystone-landscaping         # Bot identifier (string)
BOT_NAME=Keystone Hardscapes Assistant
PORT=5001                           # Default: 5001 (Flask dev server)
HOST=0.0.0.0                        # Listen on all interfaces
DEBUG=False                         # Set to True for development only

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
APP_NAME=My Bot Army
APP_VERSION=2.0.0                   # Flask migration version
LOG_LEVEL=INFO                      # DEBUG, INFO, WARNING, ERROR

# Security (optional - for future features)
SECRET_KEY=your-secret-key-here-change-in-production

# ----------------------------------------------------------------------------
# Legacy FastAPI Configuration (Not Used in Production)
# ----------------------------------------------------------------------------
# These are only needed if running the legacy FastAPI system (my_bot_army/)
# Current production uses Flask (bots/keystone-landscaping/)
#
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/my_bot_army
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=10

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
#
# Development:
#   python3 app.py                  (uses PORT and HOST above)
#
# Production (Gunicorn):
#   gunicorn --bind 0.0.0.0:5001 --workers 4 --timeout 120 app:app
#
# Required Services:
#   - PostgreSQL 15+ with pgvector extension
#   - Internet access for Anthropic and Voyage AI APIs
#
# See README.md for complete setup instructions
