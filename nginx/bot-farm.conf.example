# My Bot Army - nginx Reverse Proxy Configuration
#
# This configuration file sets up nginx as a reverse proxy
# for multiple bot instances running on different ports.
#
# Usage:
# 1. Copy this file to /etc/nginx/sites-available/bot-farm.conf
# 2. Update 'your-domain.com' with your actual domain
# 3. Enable the site: ln -s /etc/nginx/sites-available/bot-farm.conf /etc/nginx/sites-enabled/
# 4. Test configuration: nginx -t
# 5. Reload nginx: systemctl reload nginx
# 6. For HTTPS, use certbot to add SSL certificates

server {
    listen 80;
    server_name your-domain.com;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Logging
    access_log /var/log/nginx/bot-farm-access.log;
    error_log /var/log/nginx/bot-farm-error.log;

    # Keystone Landscaping Bot
    # Running on port 5000
    location /keystone/ {
        # Proxy settings
        proxy_pass http://localhost:5000/;
        proxy_http_version 1.1;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;

        # Proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts (adjust as needed)
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Add more bots here as you expand:
    #
    # Example: Another bot on port 5001
    # location /another-bot/ {
    #     proxy_pass http://localhost:5001/;
    #     proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection 'upgrade';
    #     proxy_set_header Host $host;
    #     proxy_cache_bypass $http_upgrade;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }

    # Health check endpoint for all bots
    # You can check bot health at: http://your-domain.com/health
    location = /health {
        return 200 "Bot Farm is running\n";
        add_header Content-Type text/plain;
    }

    # Default location - optional landing page
    location / {
        return 200 "My Bot Army - Multi-Bot Platform\n";
        add_header Content-Type text/plain;
    }
}

# HTTPS Configuration (uncomment after setting up SSL certificates)
#
# Run certbot to automatically configure HTTPS:
# sudo certbot --nginx -d your-domain.com
#
# Or manually configure:
# server {
#     listen 443 ssl http2;
#     server_name your-domain.com;
#
#     ssl_certificate /etc/letsencrypt/live/your-domain.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ssl_prefer_server_ciphers on;
#     ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
#
#     # Include all the location blocks from above
#     # ...
# }
#
